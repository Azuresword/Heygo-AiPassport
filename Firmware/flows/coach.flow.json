    {"id": "ui_show_timeout", "async": false},
    {"id": "ui_show_limit", "async": false},
    {"id": "ui_show_link_lost", "async": false},
    {"id": "ui_show_blocked", "async": false},
    {"id": "ui_link_ready", "async": false, "comment": "The link glue applies the ui_link_* and ui_why_* actions. No transition uses them."},
    {"id": "ui_link_down", "async": false},
    {"id": "ui_link_no_voice", "async": false},
    {"id": "ui_why_link_down", "async": false},
    {"id": "ui_why_phone_silent", "async": false},
    {"id": "ui_why_version", "async": false},
    {"id": "ui_why_mtu", "async": false},
    {"id": "ui_why_audio", "async": false},
    {"id": "audio_capture_start", "async": true},
    {"id": "audio_capture_stop", "async": true},
    {"id": "audio_play_start", "async": true},
    {"id": "audio_play_stop", "async": true},
    {"id": "link_send_agent_start", "async": true},
    {"id": "link_send_agent_end", "async": true},
    {"id": "link_send_agent_cancel", "async": true},
    {"id": "ui_show_turns", "async": false},
    {"id": "turn_next", "async": false, "comment": "Finish the drawing, or select the next turn and replay it. coach_app.c runs it."},
    {"id": "turn_prev", "async": false, "comment": "Select the previous turn and replay it. coach_app.c runs it."},
    {"id": "turn_page", "async": false, "comment": "Go to turn 1 of the next page of 8 turns. coach_app.c runs it."},
    {"id": "ui_show_popup", "async": false, "comment": "D-31. coach_app.c writes the popup texts from main/ui/popup_view.c."},
    {"id": "popup_countdown", "async": false, "comment": "Start the 10-second timer of the popup."},
    {"id": "popup_close", "async": true, "comment": "Send POPUP_END, then run the RETURN_* event of the saved page in the same step."},
    {"id": "audio_play_cut", "async": true, "comment": "Stop the speaker. Unlike audio_play_stop, keep the queued blocks."},
    {"id": "run_after_coach", "async": false, "comment": "D-32. Keep the run start. coach_app.c opens the live data page when the talk with the coach ends."},
    {"id": "popup_back_live", "async": false, "comment": "D-32. After the popup, go to the live data page, not to the saved page."}
  ],

