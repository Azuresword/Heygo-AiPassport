    {"from": "CAPTURE", "on": "RUN_START", "to": "CAPTURE", "actions": ["run_after_coach"], "comment": "D-32. The talk with the coach goes on. coach_app.c opens the live data page when the talk ends."},
    {"from": "WAIT_ANSWER", "on": "RUN_START", "to": "WAIT_ANSWER", "actions": ["run_after_coach"]},
    {"from": "PLAYBACK", "on": "RUN_START", "to": "PLAYBACK", "actions": ["run_after_coach"]},
    {"from": "POPUP_WAIT", "on": "RUN_START", "to": "POPUP_WAIT", "actions": ["popup_back_live"], "comment": "D-32. The popup stays. After it closes, the device goes to the live data page."},
    {"from": "POPUP_PLAY", "on": "RUN_START", "to": "POPUP_PLAY", "actions": ["popup_back_live"]},
