{
  "app": "coach",

  "title": "Four flat pages: live data, run report, turn shape, and AI coach (D-29, D-30), with phone popups (D-31) and the run start (D-32)",

  "strings_file": "../../assets/ui/strings.json",

  "lvgl_pool_bytes": 28672,

  "lvgl_pool_ceiling_bytes": 20480,

  "one_screen_at_a_time": true,

  "input": {
    "reserve_ok_long_for_page": true,
    "back_intents": [
      "UP_SHORT",
      "DOWN_SHORT"
    ],
    "comment": "D-29. An OK hold opens the Coach page from every page, and starts capture on the Coach page. Short UP and DOWN presses move between the four pages. D-30: inside the Turns page, a short OK press and the UP and DOWN holds move between the turns. D-31: on a popup, every key only closes the popup."
  },

