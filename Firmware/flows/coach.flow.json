    {"from": "PLAYBACK", "on": "ANSWER_END", "to": "READY", "actions": ["audio_play_stop", "ui_show_done"], "comment": "ui_show_done keeps the answer text on the screen until the next action."},
    {"from": "PLAYBACK", "on": "OK_HOLD", "to": "CAPTURE", "actions": ["audio_play_stop", "link_send_agent_cancel", "ui_show_listening", "audio_capture_start", "link_send_agent_start"], "comment": "Playback stops before the microphone starts. The device never records and plays together."},
    {"from": "PLAYBACK", "on": "DOWN_SHORT", "to": "LIVE", "actions": ["audio_play_stop", "link_send_agent_cancel", "ui_show_live"], "comment": "D-29. A page change stops the speaker and cancels the answer."},
    {"from": "PLAYBACK", "on": "UP_SHORT", "to": "TURNS", "actions": ["audio_play_stop", "link_send_agent_cancel", "ui_show_turns"]},
    {"from": "PLAYBACK", "on": "LINK_LOST", "to": "READY", "actions": ["audio_play_stop", "ui_show_link_lost"]},
    {"from": "LIVE", "on": "POPUP_SHOW", "to": "POPUP_WAIT", "actions": ["ui_show_popup"], "comment": "D-31. The phone sends POPUP. Every state accepts it at once. coach_app.c keeps the page to go back to."},
    {"from": "REPORT", "on": "POPUP_SHOW", "to": "POPUP_WAIT", "actions": ["ui_show_popup"]},
    {"from": "TURNS", "on": "POPUP_SHOW", "to": "POPUP_WAIT", "actions": ["ui_show_popup"]},
    {"from": "READY", "on": "POPUP_SHOW", "to": "POPUP_WAIT", "actions": ["ui_show_popup"]},
    {"from": "CAPTURE", "on": "POPUP_SHOW", "to": "POPUP_WAIT", "actions": ["audio_capture_stop", "link_send_agent_cancel", "ui_show_ready", "ui_show_popup"], "comment": "D-31. A popup cancels the question. The Coach page is READY again after the popup."},
    {"from": "WAIT_ANSWER", "on": "POPUP_SHOW", "to": "POPUP_WAIT", "actions": ["link_send_agent_cancel", "ui_show_ready", "ui_show_popup"]},
    {"from": "PLAYBACK", "on": "POPUP_SHOW", "to": "POPUP_WAIT", "actions": ["audio_play_cut", "link_send_agent_cancel", "ui_show_ready", "ui_show_popup"], "comment": "audio_play_cut keeps the queued blocks: the popup audio can arrive before this step."},
    {"from": "POPUP_WAIT", "on": "POPUP_SHOW", "to": "POPUP_WAIT", "actions": ["ui_show_popup"], "comment": "D-31. A new popup replaces the old one. The link sends POPUP_END reason 2 for the old one."},
    {"from": "POPUP_PLAY", "on": "POPUP_SHOW", "to": "POPUP_WAIT", "actions": ["audio_play_cut", "ui_show_popup"]},
    {"from": "POPUP_HOLD", "on": "POPUP_SHOW", "to": "POPUP_WAIT", "actions": ["ui_show_popup"]},
    {"from": "POPUP_WAIT", "on": "POPUP_NO_AUDIO", "to": "POPUP_HOLD", "actions": ["popup_countdown"], "comment": "The popup has no audio, or its audio did not start within 5 s."},
    {"from": "POPUP_WAIT", "on": "POPUP_AUDIO_START", "to": "POPUP_PLAY", "actions": ["audio_play_start"]},
    {"from": "POPUP_WAIT", "on": "LINK_LOST", "to": "POPUP_HOLD", "actions": ["popup_countdown"]},
    {"from": "POPUP_PLAY", "on": "POPUP_AUDIO_END", "to": "POPUP_HOLD", "actions": ["audio_play_stop", "popup_countdown"], "comment": "The 10-second countdown starts after the audio."},
    {"from": "POPUP_PLAY", "on": "LINK_LOST", "to": "POPUP_HOLD", "actions": ["audio_play_stop", "popup_countdown"]},
    {"from": "POPUP_WAIT", "on": "OK_SHORT", "to": "POPUP_HOLD", "actions": ["popup_close"], "comment": "D-31. Any key only closes the popup. popup_close sends POPUP_END and goes back at once."},
    {"from": "POPUP_WAIT", "on": "OK_HOLD", "to": "POPUP_HOLD", "actions": ["popup_close"]},
    {"from": "POPUP_WAIT", "on": "UP_SHORT", "to": "POPUP_HOLD", "actions": ["popup_close"]},
    {"from": "POPUP_WAIT", "on": "UP_HOLD", "to": "POPUP_HOLD", "actions": ["popup_close"]},
    {"from": "POPUP_WAIT", "on": "DOWN_SHORT", "to": "POPUP_HOLD", "actions": ["popup_close"]},
    {"from": "POPUP_WAIT", "on": "DOWN_HOLD", "to": "POPUP_HOLD", "actions": ["popup_close"]},
    {"from": "POPUP_PLAY", "on": "OK_SHORT", "to": "POPUP_HOLD", "actions": ["audio_play_stop", "popup_close"]},
    {"from": "POPUP_PLAY", "on": "OK_HOLD", "to": "POPUP_HOLD", "actions": ["audio_play_stop", "popup_close"]},
    {"from": "POPUP_PLAY", "on": "UP_SHORT", "to": "POPUP_HOLD", "actions": ["audio_play_stop", "popup_close"]},
    {"from": "POPUP_PLAY", "on": "UP_HOLD", "to": "POPUP_HOLD", "actions": ["audio_play_stop", "popup_close"]},
    {"from": "POPUP_PLAY", "on": "DOWN_SHORT", "to": "POPUP_HOLD", "actions": ["audio_play_stop", "popup_close"]},
    {"from": "POPUP_PLAY", "on": "DOWN_HOLD", "to": "POPUP_HOLD", "actions": ["audio_play_stop", "popup_close"]},
    {"from": "POPUP_HOLD", "on": "OK_SHORT", "to": "POPUP_HOLD", "actions": ["popup_close"]},
    {"from": "POPUP_HOLD", "on": "OK_HOLD", "to": "POPUP_HOLD", "actions": ["popup_close"]},
    {"from": "POPUP_HOLD", "on": "UP_SHORT", "to": "POPUP_HOLD", "actions": ["popup_close"]},
    {"from": "POPUP_HOLD", "on": "UP_HOLD", "to": "POPUP_HOLD", "actions": ["popup_close"]},
    {"from": "POPUP_HOLD", "on": "DOWN_SHORT", "to": "POPUP_HOLD", "actions": ["popup_close"]},
    {"from": "POPUP_HOLD", "on": "DOWN_HOLD", "to": "POPUP_HOLD", "actions": ["popup_close"]},
    {"from": "POPUP_HOLD", "on": "POPUP_TIMEOUT", "to": "POPUP_HOLD", "actions": ["popup_close"], "comment": "10 s after the popup audio, or 10 s after the popup with no audio."},
    {"from": "POPUP_HOLD", "on": "RETURN_LIVE", "to": "LIVE", "actions": ["ui_show_live"], "comment": "popup_close sends one RETURN_* event: the page before the popup. The Coach page states go back to READY."},
    {"from": "POPUP_HOLD", "on": "RETURN_REPORT", "to": "REPORT", "actions": ["ui_show_report"]},
    {"from": "POPUP_HOLD", "on": "RETURN_TURNS", "to": "TURNS", "actions": ["ui_show_turns"]},
    {"from": "POPUP_HOLD", "on": "RETURN_READY", "to": "READY", "actions": [], "comment": "No action: the Coach page keeps its texts."},
    {"from": "REPORT", "on": "RUN_START", "to": "LIVE", "actions": ["ui_show_live"], "comment": "D-32. The phone starts a run. The device opens the live data page. LIVE ignores the event, and the data refresh shows the new run."},
    {"from": "TURNS", "on": "RUN_START", "to": "LIVE", "actions": ["ui_show_live"]},
