  "transforms": [
    {
      "id": "tag_color",
      "from": "int",
      "to": "color",
      "map": {
        "4": "danger",
        "7": "danger"
      },
      "default": "accent",
      "comment": "The large English state word turns red for the failure and link icons."
    },
    {
      "id": "link_color",
      "from": "int",
      "to": "color",
      "map": {
        "0": "danger",
        "1": "muted"
      },
      "default": "muted"
    },
    {
      "id": "link_dot_color",
      "from": "int",
      "to": "color",
      "map": {
        "0": "danger",
        "1": "ok"
      },
      "default": "danger"
    }
  ],

  "bindings": [
    {"subject": "status_text", "target": "status.text", "screens": ["coach", "ski", "report", "turns", "popup"]},
    {"subject": "tag_text", "target": "tag.text"},
    {"subject": "icon_state", "target": "tag.color", "transform": "tag_color"},
    {"subject": "state_text", "target": "state.text"},
    {"subject": "body_text", "target": "body.text"},
    {"subject": "hint_text", "target": "hint.text"},
    {"subject": "battery_text", "target": "battery.text"},
    {"subject": "link_state", "target": "status.color", "transform": "link_color", "screens": ["coach", "ski", "report", "turns", "popup"]},
    {"subject": "link_state", "target": "link_dot.color", "transform": "link_dot_color", "screens": ["coach", "ski", "report", "turns", "popup"]},
    {"subject": "icon_state", "target": "icon.value"}
  ],

  "actions": [
    {"id": "ui_show_live", "async": false},
    {"id": "ui_show_ready", "async": false},
    {"id": "ui_show_done", "async": false},
    {"id": "ui_show_report", "async": false},
