    {"from": "WAIT_ANSWER", "on": "AGENT_TIMEOUT", "to": "READY", "actions": ["ui_show_timeout"]},
    {"from": "WAIT_ANSWER", "on": "OK_HOLD", "to": "CAPTURE", "actions": ["link_send_agent_cancel", "ui_show_listening", "audio_capture_start", "link_send_agent_start"], "comment": "A new question cancels the open exchange. A late answer then carries a stale xid."},
    {"from": "WAIT_ANSWER", "on": "DOWN_SHORT", "to": "LIVE", "actions": ["link_send_agent_cancel", "ui_show_live"], "comment": "D-29. A page change cancels the open exchange."},
    {"from": "WAIT_ANSWER", "on": "UP_SHORT", "to": "TURNS", "actions": ["link_send_agent_cancel", "ui_show_turns"]},
