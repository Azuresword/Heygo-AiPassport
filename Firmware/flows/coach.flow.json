  "transitions": [
    {"from": "LIVE", "on": "DOWN_SHORT", "to": "REPORT", "actions": ["ui_show_report"], "comment": "D-29. Three flat pages in a loop: LIVE, REPORT, and the Coach page. DOWN goes forward. UP goes back."},
    {"from": "LIVE", "on": "UP_SHORT", "to": "READY", "actions": ["ui_show_ready"]},
    {"from": "LIVE", "on": "OK_HOLD", "to": "READY", "actions": ["ui_show_ready"], "comment": "D-29. An OK hold opens the Coach page from every page. This press never starts capture."},
    {"from": "LIVE", "on": "SHOW_REPORT", "to": "REPORT", "actions": ["ui_show_report"], "comment": "D-28. The phone sends SHOW_PAGE 3. Only LIVE and READY accept it, so it never stops a question or an answer."},
    {"from": "REPORT", "on": "DOWN_SHORT", "to": "TURNS", "actions": ["ui_show_turns"], "comment": "D-30. The Turns page sits between the Report page and the Coach page."},
    {"from": "REPORT", "on": "UP_SHORT", "to": "LIVE", "actions": ["ui_show_live"]},
    {"from": "REPORT", "on": "OK_HOLD", "to": "READY", "actions": ["ui_show_ready"]},
    {"from": "TURNS", "on": "UP_SHORT", "to": "REPORT", "actions": ["ui_show_report"]},
    {"from": "TURNS", "on": "DOWN_SHORT", "to": "READY", "actions": ["ui_show_ready"]},
    {"from": "TURNS", "on": "OK_HOLD", "to": "READY", "actions": ["ui_show_ready"], "comment": "As on every page: an OK hold opens the Coach page and never starts capture."},
    {"from": "TURNS", "on": "OK_SHORT", "to": "TURNS", "actions": ["turn_next"], "comment": "D-30. Inside the page: OK goes one turn on, an UP hold one turn back, a DOWN hold one page of 8 turns on."},
    {"from": "TURNS", "on": "UP_HOLD", "to": "TURNS", "actions": ["turn_prev"]},
    {"from": "TURNS", "on": "DOWN_HOLD", "to": "TURNS", "actions": ["turn_page"]},
    {"from": "READY", "on": "OK_HOLD", "to": "CAPTURE", "actions": ["ui_show_listening", "audio_capture_start", "link_send_agent_start"], "comment": "On the Coach page, the OK hold is push-to-talk. A release sends the question."},
    {"from": "READY", "on": "DOWN_SHORT", "to": "LIVE", "actions": ["ui_show_live"]},
    {"from": "READY", "on": "UP_SHORT", "to": "TURNS", "actions": ["ui_show_turns"]},
    {"from": "READY", "on": "SHOW_REPORT", "to": "REPORT", "actions": ["ui_show_report"]},
    {"from": "READY", "on": "ASK_BLOCKED", "to": "READY", "actions": ["ui_show_blocked"], "comment": "The glue sends ASK_BLOCKED in place of OK_HOLD while voice is not available. The ui_why_* text gives the cause."},
    {"from": "READY", "on": "LINK_LOST", "to": "READY", "actions": ["ui_show_link_lost"]},
    {"from": "CAPTURE", "on": "OK_RELEASE", "to": "WAIT_ANSWER", "actions": ["audio_capture_stop", "link_send_agent_end", "ui_show_thinking"]},
    {"from": "CAPTURE", "on": "CAPTURE_LIMIT", "to": "WAIT_ANSWER", "actions": ["audio_capture_stop", "link_send_agent_end", "ui_show_limit"]},
    {"from": "CAPTURE", "on": "DOWN_SHORT", "to": "LIVE", "actions": ["audio_capture_stop", "link_send_agent_cancel", "ui_show_live"], "comment": "D-29. A page change cancels the question first. The three buttons share one ADC, so this needs the OK release first."},
    {"from": "CAPTURE", "on": "UP_SHORT", "to": "TURNS", "actions": ["audio_capture_stop", "link_send_agent_cancel", "ui_show_turns"]},
    {"from": "CAPTURE", "on": "LINK_LOST", "to": "READY", "actions": ["audio_capture_stop", "ui_show_link_lost"]},
