{
  "app": "coach",
  "title": "Coach voice chain (P0)",
  "strings_file": "../../assets/ui/strings.json",
  "lvgl_pool_bytes": 24576,
  "lvgl_pool_ceiling_bytes": 20480,

  "input": {
    "reserve_ok_long_for_page": true,
    "back_intents": ["DOWN_HOLD"],
    "comment": "The Coach page uses the OK hold for capture. D-10 makes the DOWN hold the way back."
  },

  "subjects": [
    { "id": "status_text", "type": "string", "initial": "未连接", "size": 32 },
    { "id": "state_text",  "type": "string", "initial": "就绪", "size": 32 },
    { "id": "body_text",   "type": "string", "initial": "按住说话，松开发送", "size": 240 },
    { "id": "hint_text",   "type": "string", "initial": "长按 OK 提问", "size": 48 },
    { "id": "battery_text", "type": "string", "initial": "", "size": 16 },
    { "id": "link_state",  "type": "int",    "initial": 0, "comment": "0 down, 1 up" },
    { "id": "icon_state",  "type": "int",    "initial": 0,
      "comment": "0 ready, 1 listening, 2 thinking, 3 answering, 4 failed, 5 ski, 6 exit, 7 link lost" }
  ],

  "screens": [
    {
      "id": "coach",
      "widgets": [
        { "id": "top_panel",  "type": "obj", "x": 10, "y": 9,   "w": 220, "h": 32,  "bg": "surface",    "radius": 16 },
        { "id": "body_panel", "type": "obj", "x": 10, "y": 158, "w": 220, "h": 106, "bg": "surface",    "radius": 14, "border_width": 1, "border_color": "surface_hi" },
        { "id": "hint_panel", "type": "obj", "x": 10, "y": 276, "w": 220, "h": 35,  "bg": "surface_hi", "radius": 18 },
        { "id": "link_dot", "type": "obj", "x": 106, "y": 21, "w": 7, "h": 7, "color": "danger", "radius": 4 },
        { "id": "icon", "type": "state_icon", "x": 14, "y": 76, "w": 64, "h": 64, "value": 0 },
        { "id": "mode", "type": "label", "x": 22, "y": 14, "w": 76, "text": "休息模式", "font": "heygo_sc_16", "color": "ink" },
        { "id": "status", "type": "label", "x": 118, "y": 14, "w": 62, "text": "未连接", "font": "heygo_sc_16", "color": "danger" },
        { "id": "battery", "type": "label", "x": 188, "y": 16, "w": 30, "align": "top_right", "text": "", "font": "montserrat_14", "color": "muted" },
        { "id": "dest", "type": "label", "x": 14, "y": 49, "w": 212, "text": "AI COACH", "font": "montserrat_14", "color": "accent", "letter_space": 2 },
        { "id": "state", "type": "label", "x": 91, "y": 86, "w": 135, "text": "就绪", "font": "heygo_sc_28", "color": "ink" },
        { "id": "body", "type": "label", "x": 22, "y": 170, "w": 196, "h": 80, "text": "按住说话，松开发送", "font": "heygo_sc_16", "color": "ink", "long_mode": "dots" },
        { "id": "hint", "type": "label", "x": 22, "y": 282, "w": 196, "align": "top_mid", "text": "长按 OK 提问", "font": "heygo_sc_16", "color": "ink" }
      ]
    },
    {
      "id": "ski",
      "widgets": [
        { "id": "top_panel",  "type": "obj", "x": 10, "y": 9,   "w": 220, "h": 32,  "bg": "surface",    "radius": 16 },
        { "id": "body_panel", "type": "obj", "x": 10, "y": 158, "w": 220, "h": 106, "bg": "surface",    "radius": 14, "border_width": 1, "border_color": "surface_hi" },
        { "id": "hint_panel", "type": "obj", "x": 10, "y": 276, "w": 220, "h": 35,  "bg": "surface_hi", "radius": 18 },
        { "id": "mode_dot", "type": "obj", "x": 22, "y": 21, "w": 7, "h": 7, "color": "accent", "radius": 4 },
        { "id": "icon", "type": "state_icon", "x": 14, "y": 76, "w": 64, "h": 64, "value": 5 },
        { "id": "mode", "type": "label", "x": 36, "y": 14, "w": 110, "text": "滑行模式", "font": "heygo_sc_16", "color": "ink" },
        { "id": "battery", "type": "label", "x": 188, "y": 16, "w": 30, "align": "top_right", "text": "", "font": "montserrat_14", "color": "muted" },
        { "id": "dest", "type": "label", "x": 14, "y": 49, "w": 212, "text": "LIVE RUN", "font": "montserrat_14", "color": "accent", "letter_space": 2 },
        { "id": "title", "type": "label", "x": 91, "y": 86, "w": 135, "text": "滑行中", "font": "heygo_sc_28", "color": "ink" },
        { "id": "body", "type": "label", "x": 22, "y": 176, "w": 196, "h": 70, "text": "专注雪道，教练随时待命", "font": "heygo_sc_16", "color": "ink", "long_mode": "wrap" },
        { "id": "hint", "type": "label", "x": 22, "y": 282, "w": 196, "align": "top_mid", "text": "长按 OK 进入休息", "font": "heygo_sc_16", "color": "ink" }
      ]
    },
    {
      "id": "exit",
      "widgets": [
        { "id": "top_panel",  "type": "obj", "x": 10, "y": 9,   "w": 220, "h": 32,  "bg": "surface",    "radius": 16 },
        { "id": "body_panel", "type": "obj", "x": 10, "y": 158, "w": 220, "h": 106, "bg": "surface",    "radius": 14, "border_width": 1, "border_color": "surface_hi" },
        { "id": "hint_panel", "type": "obj", "x": 10, "y": 276, "w": 220, "h": 35,  "bg": "surface_hi", "radius": 18 },
        { "id": "mode_dot", "type": "obj", "x": 22, "y": 21, "w": 7, "h": 7, "color": "danger", "radius": 4 },
        { "id": "icon", "type": "state_icon", "x": 14, "y": 76, "w": 64, "h": 64, "value": 6 },
        { "id": "mode", "type": "label", "x": 36, "y": 14, "w": 110, "text": "休息模式", "font": "heygo_sc_16", "color": "ink" },
        { "id": "battery", "type": "label", "x": 188, "y": 16, "w": 30, "align": "top_right", "text": "", "font": "montserrat_14", "color": "muted" },
        { "id": "dest", "type": "label", "x": 14, "y": 49, "w": 212, "text": "SESSION CONTROL", "font": "montserrat_14", "color": "danger", "letter_space": 1 },
        { "id": "title", "type": "label", "x": 91, "y": 75, "w": 135, "h": 70, "text": "退出休息模式？", "font": "heygo_sc_28", "color": "ink", "long_mode": "wrap" },
        { "id": "primary", "type": "label", "x": 22, "y": 176, "w": 196, "text": "OK  退出休息模式", "font": "heygo_sc_16", "color": "accent" },
        { "id": "secondary", "type": "label", "x": 22, "y": 216, "w": 196, "text": "UP / DOWN  返回", "font": "heygo_sc_16", "color": "muted" },
        { "id": "hint", "type": "label", "x": 22, "y": 282, "w": 196, "align": "top_mid", "text": "短按 OK 确认", "font": "heygo_sc_16", "color": "ink" }
      ]
    }
  ],

  "transforms": [
    { "id": "link_color", "from": "int", "to": "color", "map": { "0": "danger", "1": "muted" }, "default": "muted" },
    { "id": "link_dot_color", "from": "int", "to": "color", "map": { "0": "danger", "1": "ok" }, "default": "danger" }
  ],

  "bindings": [
    { "subject": "status_text", "target": "status.text" },
    { "subject": "state_text",  "target": "state.text" },
    { "subject": "body_text",   "target": "body.text" },
    { "subject": "hint_text",   "target": "hint.text" },
    { "subject": "battery_text", "target": "battery.text" },
    { "subject": "link_state",  "target": "status.color", "transform": "link_color" },
    { "subject": "link_state",  "target": "link_dot.color", "transform": "link_dot_color" },
    { "subject": "icon_state",  "target": "icon.value" }
  ],

  "actions": [
    { "id": "ui_show_ski",            "async": false },
    { "id": "ui_show_rest",           "async": false },
    { "id": "ui_show_done",           "async": false },
    { "id": "ui_show_exit",           "async": false },
    { "id": "ui_show_listening",      "async": false },
    { "id": "ui_show_thinking",       "async": false },
    { "id": "ui_show_answering",      "async": false },
    { "id": "ui_show_retry",          "async": false },
    { "id": "ui_show_timeout",        "async": false },
    { "id": "ui_show_limit",          "async": false },
    { "id": "ui_show_link_lost",      "async": false },
    { "id": "ui_show_blocked",        "async": false },
    { "id": "ui_link_ready",          "async": false, "comment": "The link glue applies the ui_link_* and ui_why_* actions. No transition uses them." },
    { "id": "ui_link_down",           "async": false },
    { "id": "ui_link_no_voice",       "async": false },
    { "id": "ui_why_link_down",       "async": false },
    { "id": "ui_why_phone_silent",    "async": false },
    { "id": "ui_why_version",         "async": false },
    { "id": "ui_why_mtu",             "async": false },
    { "id": "ui_why_audio",           "async": false },
    { "id": "audio_capture_start",    "async": true },
    { "id": "audio_capture_stop",     "async": true },
    { "id": "audio_play_start",       "async": true },
    { "id": "audio_play_stop",        "async": true },
    { "id": "link_send_agent_start",  "async": true },
    { "id": "link_send_agent_end",    "async": true },
    { "id": "link_send_agent_cancel", "async": true }
  ],

  "ui_effects": {
    "comment": "The subject values that each ui_show_* action sets. A value is a key in assets/ui/strings.json, or an empty text. n fills {n}. A missing subject keeps its value.",
    "ui_show_ski":       {},
    "ui_show_exit":      {},
    "ui_show_rest":      { "state_text": "state.ready",     "body_text": "msg.ready",     "hint_text": "hint.ready",     "icon_state": 0 },
    "ui_show_done":      { "state_text": "state.ready",                                    "hint_text": "hint.ready",     "icon_state": 0 },
    "ui_show_listening": { "state_text": "state.listening", "body_text": "msg.listening", "hint_text": "hint.listening", "icon_state": 1 },
    "ui_show_thinking":  { "state_text": "state.thinking",  "body_text": "msg.sent",      "hint_text": "hint.thinking",  "icon_state": 2 },
    "ui_show_answering": { "state_text": "state.answering",                                "hint_text": "hint.answering", "icon_state": 3 },
    "ui_show_retry":     { "state_text": "state.failed",    "body_text": "msg.retry",     "hint_text": "hint.ready",     "icon_state": 4 },
    "ui_show_timeout":   { "state_text": "state.failed",    "body_text": "msg.timeout",   "hint_text": "hint.ready",     "icon_state": 4 },
    "ui_show_limit":     { "state_text": "state.thinking",  "body_text": { "key": "msg.limit", "n": 20 }, "hint_text": "hint.thinking", "icon_state": 2 },
    "ui_show_link_lost": { "state_text": "state.failed",    "body_text": "msg.link_lost", "hint_text": "hint.ready",     "icon_state": 7 },
    "ui_show_blocked":     { "state_text": "state.failed", "hint_text": "hint.ready", "icon_state": 7 },
    "ui_link_ready":       { "status_text": "status.link_up", "link_state": 1 },
    "ui_link_down":        { "status_text": "status.link_down", "link_state": 0 },
    "ui_link_no_voice":    { "status_text": "msg.voice_off", "link_state": 0 },
    "ui_why_link_down":    { "body_text": "msg.link_lost" },
    "ui_why_phone_silent": { "body_text": "msg.phone_silent" },
    "ui_why_version":      { "body_text": "msg.version" },
    "ui_why_mtu":          { "body_text": "msg.voice_off" },
    "ui_why_audio":        { "body_text": "msg.voice_off" }
  },

  "states": [
    { "id": "SKI",         "screen": "ski",   "initial": true, "root": true },
    { "id": "READY",       "screen": "coach" },
    { "id": "CAPTURE",     "screen": "coach" },
    { "id": "WAIT_ANSWER", "screen": "coach" },
    { "id": "PLAYBACK",    "screen": "coach" },
    { "id": "EXIT_Q",      "screen": "exit" }
  ],

  "transitions": [
    { "from": "SKI", "on": "OK_HOLD", "to": "READY", "actions": ["ui_show_rest"],
      "comment": "D-15. This press enters Rest mode. One press gives one OK_HOLD, so it cannot also start capture." },

    { "from": "READY", "on": "OK_HOLD", "to": "CAPTURE",
      "actions": ["ui_show_listening", "audio_capture_start", "link_send_agent_start"] },
    { "from": "READY", "on": "DOWN_HOLD", "to": "EXIT_Q", "actions": ["ui_show_exit"] },
    { "from": "READY", "on": "ASK_BLOCKED", "to": "READY", "actions": ["ui_show_blocked"],
      "comment": "The glue sends ASK_BLOCKED in place of OK_HOLD while voice is not available. The ui_why_* text gives the cause." },
    { "from": "READY", "on": "LINK_LOST", "to": "READY", "actions": ["ui_show_link_lost"] },

    { "from": "CAPTURE", "on": "OK_RELEASE", "to": "WAIT_ANSWER",
      "actions": ["audio_capture_stop", "link_send_agent_end", "ui_show_thinking"] },
    { "from": "CAPTURE", "on": "CAPTURE_LIMIT", "to": "WAIT_ANSWER",
      "actions": ["audio_capture_stop", "link_send_agent_end", "ui_show_limit"] },
    { "from": "CAPTURE", "on": "UP_HOLD", "to": "READY",
      "actions": ["audio_capture_stop", "link_send_agent_cancel", "ui_show_rest"] },
    { "from": "CAPTURE", "on": "LINK_LOST", "to": "READY",
      "actions": ["audio_capture_stop", "ui_show_link_lost"] },

    { "from": "WAIT_ANSWER", "on": "ANSWER_START", "to": "PLAYBACK",
      "actions": ["ui_show_answering", "audio_play_start"] },
    { "from": "WAIT_ANSWER", "on": "ANSWER_FAILED", "to": "READY", "actions": ["ui_show_retry"] },
    { "from": "WAIT_ANSWER", "on": "AGENT_TIMEOUT", "to": "READY", "actions": ["ui_show_timeout"] },
    { "from": "WAIT_ANSWER", "on": "UP_HOLD", "to": "READY",
      "actions": ["link_send_agent_cancel", "ui_show_rest"] },
    { "from": "WAIT_ANSWER", "on": "OK_HOLD", "to": "CAPTURE",
      "actions": ["link_send_agent_cancel", "ui_show_listening", "audio_capture_start", "link_send_agent_start"],
      "comment": "A new question cancels the open exchange. A late answer then carries a stale xid." },
    { "from": "WAIT_ANSWER", "on": "LINK_LOST", "to": "READY", "actions": ["ui_show_link_lost"] },

    { "from": "PLAYBACK", "on": "ANSWER_END", "to": "READY",
      "actions": ["audio_play_stop", "ui_show_done"],
      "comment": "ui_show_done keeps the answer text on the screen until the next action." },
    { "from": "PLAYBACK", "on": "UP_HOLD", "to": "READY",
      "actions": ["audio_play_stop", "link_send_agent_cancel", "ui_show_rest"] },
    { "from": "PLAYBACK", "on": "OK_HOLD", "to": "CAPTURE",
      "actions": ["audio_play_stop", "link_send_agent_cancel", "ui_show_listening", "audio_capture_start", "link_send_agent_start"],
      "comment": "Playback stops before the microphone starts. The device never records and plays together." },
    { "from": "PLAYBACK", "on": "LINK_LOST", "to": "READY",
      "actions": ["audio_play_stop", "ui_show_link_lost"] },

    { "from": "EXIT_Q", "on": "OK_SHORT",   "to": "SKI",   "actions": ["ui_show_ski"] },
    { "from": "EXIT_Q", "on": "UP_SHORT",   "to": "READY", "actions": ["ui_show_rest"] },
    { "from": "EXIT_Q", "on": "DOWN_SHORT", "to": "READY", "actions": ["ui_show_rest"] },
    { "from": "EXIT_Q", "on": "UP_HOLD",    "to": "READY", "actions": ["ui_show_rest"] },
    { "from": "EXIT_Q", "on": "DOWN_HOLD",  "to": "READY", "actions": ["ui_show_rest"] },
    { "from": "EXIT_Q", "on": "OK_HOLD",    "to": "READY", "actions": ["ui_show_rest"] }
  ]
}
